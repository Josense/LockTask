<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <application>
        <service
            android:name="com.josense.locktask.data.notification.TaskReminderService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps user-enabled lock-screen task reminders active until dismissed, disabled, completed, or deleted." />
        </service>
        <receiver
            android:name="com.josense.locktask.data.notification.TaskNotificationDismissReceiver"
            android:exported="false" />
    </application>
</manifest>
